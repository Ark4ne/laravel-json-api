# PHPStan extension of ark4ne/laravel-json-api: types the factories this package registers in
# ark4ne/laravel-api-revisions (Schema::decimal(), Schema::json(), Schema::mixed()) and the conditions it adds to
# every descriptor (->unless(), ->whenNotNull(), ->whenFilled()).
# Included automatically with phpstan/extension-installer, or by hand, after the extension of the base:
#   includes:
#       - vendor/ark4ne/laravel-api-revisions/extension.neon
#       - vendor/ark4ne/laravel-json-api/extension.neon
parameters:
    apiRevisions:
        types:
            decimal: Ark4ne\JsonApi\Descriptors\Schemas\DecimalSchema
            json: Ark4ne\JsonApi\Descriptors\Schemas\JsonSchema
            mixed: Ark4ne\JsonApi\Descriptors\Schemas\MixedSchema
            relationship: Ark4ne\JsonApi\Descriptors\Schemas\RelationshipSchema
        macros:
            unless: 'Ark4ne\JsonApi\Descriptors\Schemas\Conditions::unless'
            whenNotNull: 'Ark4ne\JsonApi\Descriptors\Schemas\Conditions::whenNotNull'
            whenFilled: 'Ark4ne\JsonApi\Descriptors\Schemas\Conditions::whenFilled'
