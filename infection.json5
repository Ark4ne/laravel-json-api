{
    "$schema": "https://raw.githubusercontent.com/infection/infection/master/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log"
    },
    "tmpDir": "build/infection",
    // Infection is installed globally: it does not find the project's PHPUnit by itself.
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "minMsi": 80,
    "minCoveredMsi": 80,
    "mutators": {
        "@default": true
    }
}
